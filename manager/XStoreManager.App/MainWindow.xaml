<Window x:Class="XStoreManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="XStore Manager" Width="1320" Height="880" MinWidth="1050" MinHeight="800" Background="#16171E" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#20212A" BorderBrush="#353642" BorderThickness="0,0,0,1">
      <Grid Margin="25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock FontSize="24" FontWeight="Bold" Text="XSTORE MANAGER"/><TextBlock x:Name="Subtitle" Text="Your libraries. Your profiles. One place." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="Scan libraries" Click="Scan_Click"/><Button x:Name="CancelButton" Content="Cancel scan" Click="Cancel_Click" Visibility="Collapsed"/><Button x:Name="AddGameButton" Content="+ Add game" Click="AddGame_Click"/><Button x:Name="AddRootButton" Content="Add library root" Click="AddRoot_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#1C1D25" BorderBrush="#353642" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="22,24,22,15"><TextBlock Text="GAME LIBRARY" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="GameSearch" Margin="0,12,0,0" ToolTip="Search games by name, path or store ID" TextChanged="GameSearch_Changed"/><TextBlock Text="Search games" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,5,0,0"/></StackPanel>
        <ListBox x:Name="GameList" Grid.Row="1" SelectionChanged="GameList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StoreId, StringFormat=Store ID: {0}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <StackPanel Grid.Row="2" Margin="22,15,22,22"><TextBlock x:Name="LibraryCount" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="RootCount" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Scanning never installs files." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel>
      </Grid></Border>
      <Grid Grid.Column="1" Margin="28,24,28,20">
        <TextBlock x:Name="EmptyState" Text="Add a game folder or scan your libraries to get started." FontSize="19" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <Grid x:Name="DetailPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="GAME PROFILE" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBox x:Name="NameField" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="27" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="0,6" ToolTip="Edit profile name"/>
            <Border Background="#252333" CornerRadius="5" Padding="11,9" Margin="0,8,0,16"><TextBlock x:Name="InstallStatus" TextWrapping="Wrap" Foreground="#C9BEF6"/></Border>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Game / runtime folder" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/><DockPanel><Button x:Name="GameFolderButton" Content="Browse" DockPanel.Dock="Right" Margin="8,0,0,0" Click="GameFolder_Click"/><TextBox x:Name="DirectoryField" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Folder containing the game's XGameRuntime.dll"/></DockPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Base game store ID" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/><TextBox Text="{Binding StoreId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
            <WrapPanel Margin="0,9,0,0"><CheckBox x:Name="EnabledToggle" Content="Enable runtime unlocker" IsChecked="{Binding Enabled}" ToolTip="Off by default. Install / Apply writes this setting."/><CheckBox x:Name="ExcludedToggle" Content="Exclude from installation" IsChecked="{Binding Excluded}"/><CheckBox Content="Enable logging" IsChecked="{Binding EnableLogging}"/></WrapPanel>
            <Expander Header="Advanced options" Foreground="{StaticResource Muted}" Margin="0,3,0,10"><StackPanel Margin="0,8"><CheckBox x:Name="UnlockToggle" Content="Unlock all DLC (advanced, bypasses selection)" IsChecked="{Binding UnlockAll}"/><CheckBox x:Name="AdoptIniToggle" Content="Adopt an existing INI on next Apply (original will be backed up)"/><TextBlock Text="Game executable (optional, must be inside the runtime folder)" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,5"/><TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Selected DLC are applied individually by default. Blocked entries remain blocked." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Expander>
          </StackPanel>
          <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Downloadable content" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DlcCount" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Search DLC" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/><TextBox x:Name="DlcSearch" TextChanged="DlcSearch_Changed" ToolTip="Search DLC by name or store ID"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh catalogue" Click="Refresh_Click" Margin="0" VerticalAlignment="Bottom"/></Grid>
            <DataGrid x:Name="DlcGrid" Grid.Row="1" MinHeight="110" IsReadOnly="False"><DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Use" Width="45" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/>
              <DataGridCheckBoxColumn Header="Block" Width="50" Binding="{Binding Blocked, UpdateSourceTrigger=PropertyChanged}"/>
              <DataGridTextColumn Header="DLC name" Width="*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
              <DataGridTextColumn Header="Store ID" Width="135" Binding="{Binding StoreId, UpdateSourceTrigger=PropertyChanged}"/>
              <DataGridTextColumn Header="Mount path (editable)" Width="1.1*" Binding="{Binding MountPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns></DataGrid>
            <WrapPanel Grid.Row="2" Margin="0,11,0,0"><WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,7,5"/></Style></WrapPanel.Resources><Button x:Name="SelectVisibleButton" Content="Select visible" Click="SelectVisible_Click"/><Button x:Name="ClearVisibleButton" Content="Clear visible" Click="ClearVisible_Click"/><Button x:Name="AddDlcButton" Content="+ Add DLC" Click="AddDlc_Click"/><Button Content="Set DLC folder" Click="DlcFolder_Click"/><Button Content="Remove DLC" Click="RemoveDlc_Click"/><Button Content="Import INI" Click="Import_Click"/><Button Content="Export INI" Click="ExportIni_Click"/><Button x:Name="ImportProfileButton" Content="Import profile" Click="ImportProfile_Click"/><Button Content="Export profile" Click="ExportProfile_Click"/></WrapPanel>
          </Grid>
          <StackPanel Grid.Row="3" Margin="0,18,0,0"><Border Height="1" Background="#353642" Margin="0,0,0,16"/><WrapPanel><Button x:Name="SaveButton" Content="Save profile" Click="Save_Click"/><Button x:Name="InstallButton" Content="Install / Apply" Click="Install_Click" Background="#7352CA" BorderBrush="#9673E8" FontWeight="SemiBold"/><Button x:Name="RepairButton" Content="Repair" Click="Install_Click"/><Button x:Name="UninstallButton" Content="Uninstall / Restore" Click="Uninstall_Click"/><Button Content="Open folder" Click="OpenFolder_Click"/><Button Content="View log" Click="ViewLog_Click"/></WrapPanel></StackPanel>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#20212A" BorderBrush="#353642" BorderThickness="0,1,0,0"><DockPanel Margin="24,0"><ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" Width="125" Height="4" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
</Window>
